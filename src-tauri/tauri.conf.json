{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droid Vault",
  "version": "0.2.9",
  "identifier": "com.droidvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Droid Vault",
        "width": 900,
        "height": 600,
        "minWidth": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ntd237/droid-vault-12092026/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4MkU0N0E0Q0NFNkIwNjAKUldSZ3NPYk1wRWN1Mk5jUUxGc3Q0QzIxR0hqSmJRMVpOTXpuYlVVU3V3MXRINlI2dUtsTlVrREoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": "FEA4C885C5790C6CF48A5B79AB3536783C5C4930",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
